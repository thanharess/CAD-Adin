		<!-- DLL thứ 2 chứa CommandMethod (nếu tách riêng) -->
		<ComponentEntry
			AppName="BlockTools"
			ModuleName="./Contents/Windows/BlockTools.dll"
			AppDescription="Tool CAD - Block/Text/Dim commands"
